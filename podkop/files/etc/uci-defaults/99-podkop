#!/bin/sh
# apk (OpenWrt 25.12 and later) does not overwrite a file under /etc that was
# edited in place or that no package owns: it keeps that file and installs the package's
# one beside it as .apk-new. An /etc/init.d/podkop of podkop's shell backend that was
# edited stays in place then: the service runs the shell backend's script, which calls
# /usr/bin/podkop (the binary of this package) for its actions, and this binary calls the
# script back. Put the package's scripts in place, the old ones aside in /usr/share/podkop
# (not in /etc/init.d, where they would show as services); a script that could not be
# replaced stays where it was. This runs before default_postinst enables and starts the
# services of the package.
for service in podkop podkop-guard; do
	[ -f /etc/init.d/$service.apk-new ] || continue
	mkdir -p /usr/share/podkop
	old=/usr/share/podkop/$service.init.before-podkop-0.8 kept=""
	if [ -f /etc/init.d/$service ] && mv -f /etc/init.d/$service $old 2>/dev/null; then
		chmod 0644 $old
		kept=", the old one is $old"
	fi
	if mv -f /etc/init.d/$service.apk-new /etc/init.d/$service 2>/dev/null; then
		logger -t podkop "/etc/init.d/$service was not the one of the package (edited, or left by another install) and apk kept it: replaced$kept"
	else
		[ -z "$kept" ] || mv -f $old /etc/init.d/$service
		logger -t podkop "/etc/init.d/$service is not the one of the package and could not be replaced by /etc/init.d/$service.apk-new"
	fi
done

# podkop 0.7 kept its files in the directories of the sing-box package: this package uses
# none of them, nor the settings of sing-box (the backend has sing-box inside). config_path
# named where the shell backend wrote its configuration: nothing is written there now. The
# cache file of sing-box moves to the same name in the backend's own directories, so the
# FakeIP addresses handed out before stay theirs.
uci -q delete podkop.settings.config_path
cache=$(uci -q get podkop.settings.cache_path)
case "$cache" in
/tmp/sing-box/*) new=/var/run/podkop/${cache#/tmp/sing-box/} ;;
/usr/share/sing-box/*) new=/usr/share/podkop/${cache#/usr/share/sing-box/} ;;
*) new="" ;;
esac
if [ -n "$new" ]; then
	uci -q set podkop.settings.cache_path="$new"
	if [ -f "$cache" ] && [ ! -e "$new" ]; then
		mkdir -p "${new%/*}" && mv -f "$cache" "$new" && logger -t podkop "the cache file moved from $cache to $new"
	fi
fi
uci -q commit podkop

# The settings of podkop 0.7 and of podkop-exp up to 0.8.7 take the format of 0.8.8: the servers
# of a section move to the tab Servers (sources) and to the rows of the section (members).
# The old file stays as /etc/config/podkop.pre-0.8.8. Settings of the format already are left alone.
/usr/bin/podkop migrate 2>&1 | logger -t podkop

# The server check of 0.8.10: five URLs of different operators taken in turn, a round every
# minute. Settings that kept the defaults of an older release take the new ones, once: the URL
# of Google alone and a round every 3 minutes (LuCI wrote both when its page was saved) are
# removed, and the defaults of the backend apply. URLs and an interval set by hand stay.
# podkop.settings.urltest_defaults tells that it was done.
if [ "$(uci -q get podkop.settings)" = settings ] && [ -z "$(uci -q get podkop.settings.urltest_defaults)" ]; then
	[ "$(uci -q get podkop.settings.urltest_testing_url)" = https://www.gstatic.com/generate_204 ] &&
		uci -q delete podkop.settings.urltest_testing_url
	[ "$(uci -q get podkop.settings.urltest_check_interval)" = 3m ] &&
		uci -q delete podkop.settings.urltest_check_interval
	uci -q set podkop.settings.urltest_defaults='0.8.10'
	uci -q commit podkop
fi
exit 0
