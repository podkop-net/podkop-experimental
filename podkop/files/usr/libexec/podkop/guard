#!/bin/sh
# podkop guard (service /etc/init.d/podkop-guard): what the backend cannot do for itself,
# because it is the one that is down. Adapted from the failsafe of podkop-engine.
#
# 1. A crash loop. procd starts the backend again 5 s after a crash and gives up after the
#    fifth crash in a row that came less than 10 minutes after its start (respawn 600 5 5
#    in /etc/init.d/podkop): it reports instance.fail. dnsmasq would keep sending every
#    query to 127.0.0.42, where nothing listens any more: the whole LAN without DNS. The
#    guard stops podkop then, and the stop gives the router its own DNS back
#    (podkop release). When the binary cannot even run that, the guard points dnsmasq at the
#    router's servers and removes the firewall table itself. Internet keeps working without
#    the proxy; the cause goes to the log and to /usr/share/podkop/guard.last. podkop is started
#    again by hand or by a reboot once the cause is fixed.
# 2. A backend that runs and answers nothing (a deadlock, a stall): procd does not restart
#    it, and dnsmasq keeps asking it. Every PROBE_INTERVAL seconds the guard asks the DNS
#    inbound (127.0.0.42) for the name the backend answers itself with a FakeIP address. Its
#    silence counts only while the backend says it runs (/var/run/podkop/state): a backend
#    that has released the router is silent on purpose, and starting or applying a
#    configuration may take minutes (remote lists are fetched before sing-box listens). A
#    start or an apply that takes longer than STUCK seconds counts as silence too. After
#    PROBE_FAILURES silent rounds in a row the backend is killed; procd starts it again,
#    and the kill counts as a crash above.
#    What does not count: a query the router does not deliver (router_silent); a round in
#    which the script itself or its query ran late, the processes of the router being
#    starved (round_late). A kill cures none of these.
# 3. A start that failed for a passing reason: an address the backend listens on was not
#    there (the loopback while the network restarted), a port another program held. The
#    backend gives the router back, says "failed" in its state, and tries again at the next
#    change of the network (hotplug.d/iface/50-podkop). A cause that no change of the
#    network ends (a program that held a port and has gone) would leave the proxy off for
#    good: from RETRY seconds after the failure the guard asks the backend that failed to
#    try again, every RETRY seconds. The backend tries when a try is due: after the first
#    few, it waits longer after each failure, up to an hour.
# A dnsmasq that runs with an older configuration than its file is the backend's to look
# after (dnsmasq.Watch): the backend changes dnsmasq with a reload, which leaves no such
# process, and restarts one that a restart by another program left.
# Off: uci set podkop.settings.guard=0 (every part) or podkop.settings.liveness=0 (the probe
# only); uci commit podkop; service podkop-guard restart

FIFO=/var/run/podkop-guard.fifo
# left by the probe when it kills the backend: "<pid> <time> <seconds without an answer>"
MARK=/var/run/podkop-guard.liveness
# what the guard last stopped podkop for: the system log is in RAM and is lost at a reboot
LAST=/usr/share/podkop/guard.last
# what the backend is doing: "<state> <pid> <since>", written by the backend
STATE=/var/run/podkop/state
main=$$

PROBE_INTERVAL=20
PROBE_TIMEOUT=3
PROBE_FAILURES=3
# ReadinessName and DNSAddress of dataplane (src/backend): the backend answers this name itself
PROBE_NAME=ready.fakeipchecker.podkop.net
PROBE_SERVER=127.0.0.42
STUCK=480
RETRY=300

log() { logger -t podkop-guard "$*"; }
off() { case "$1" in 0 | off | false | no | disabled) return 0 ;; esac; return 1; }

# kernel OOM kills since boot; the ring buffer of dmesg rotates, this counter does not
oom_kills() { awk '/^oom_kill /{print $2}' /proc/vmstat 2>/dev/null; }
last_error() {
	logread -l 300 2>/dev/null | grep -E 'podkop\[[0-9]+\]: .*(FATAL|panic|fatal error|\[error\])' | tail -n 1 |
		sed 's/^.*podkop\[[0-9]*\]: //' | cut -c 1-300
}

rm -f "$FIFO" "$MARK" /var/run/podkop-guard.dnsmasq
mkfifo "$FIFO" || exit 1
# Keep one `ubus subscribe` running. After a restart of ubusd the old subscriber keeps
# running but receives nothing, so subscribe again when the ubusd process changes. The
# loop ends within seconds once this script is stopped, so nothing is left behind.
(
	while kill -0 "$main" 2>/dev/null; do
		bus=$(pidof ubusd)
		ubus -S subscribe service &
		sub=$!
		while kill -0 "$main" 2>/dev/null && kill -0 "$sub" 2>/dev/null && [ -d "/proc/$bus" ]; do
			sleep 5
		done
		kill "$sub" 2>/dev/null
		sleep 1
	done
) > "$FIFO" &

# The backend procd runs: prints its PID, nothing when procd runs none; fails when procd
# could not be asked.
backend_pid() {
	services=$(ubus -t 5 call service list '{"name":"podkop"}' 2>/dev/null) || return 1
	[ -n "$services" ] || return 1
	jsonfilter -s "$services" -e '@["podkop"]["instances"]["main"]["pid"]' 2>/dev/null
	return 0
}

# 0: an answer came (an error answer too), 1: none, 2: could not ask
probe() {
	answer=$(nslookup -timeout=$PROBE_TIMEOUT -retry=1 "$PROBE_NAME" "$PROBE_SERVER" 2>&1) && return 0
	case "$answer" in
	*'timed out'* | *'no servers could be reached'*) return 1 ;;
	*"can't find"* | *NXDOMAIN* | *SERVFAIL* | *REFUSED*) return 0 ;;
	*) return 2 ;;
	esac
}

# Is it the router that does not deliver the query, not the backend that does not answer
# it: a full connection table drops new flows, those of the loopback and the probe's query
# among them, and so does a kernel that cannot pass a packet in time. The kernel itself
# answers the control, a ping, over the same way; it says nothing of processes. The ping
# is a control only where it has been answered once ($control, set while the backend
# answers).
router_silent() {
	count=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
	max=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)
	[ -n "$count" ] && [ "${max:-0}" -gt 0 ] && [ "$count" -ge $((max * 95 / 100)) ] && return 0
	[ "$control" = 1 ] || return 1
	! ping -c 1 -W "$PROBE_TIMEOUT" "$PROBE_SERVER" >/dev/null 2>&1
}

# Whether the silence of the backend with this PID counts: it says it runs, or it has been
# starting or applying for longer than STUCK seconds. A state written by another process
# is that of the one before: the backend writes its own at once.
judged() {
	# names of their own: the loop below keeps its count in since
	bstate="" bpid="" bsince=""
	read -r bstate bpid bsince < "$STATE" 2>/dev/null
	[ "$bpid" = "$1" ] || return 1
	case "$bstate" in
	running) return 0 ;;
	booting | applying) [ $(($(date +%s) - ${bsince:-0})) -ge "$STUCK" ] ;;
	*) return 1 ;;
	esac
}

if ! off "$(uci -q get podkop.settings.liveness)"; then
	(
		fails=0
		since=0
		standing=0     # rounds in a row that did not count for the router's own sake
		control=""     # 1 once the router has answered the control ping
		tries=0
		while kill -0 "$main" 2>/dev/null; do
			waited=0
			began=$(date +%s)
			while [ "$waited" -lt "$PROBE_INTERVAL" ] && kill -0 "$main" 2>/dev/null; do
				sleep 5
				waited=$((waited + 5))
			done
			kill -0 "$main" 2>/dev/null || break
			# procd could not be asked: the round says nothing
			pid=$(backend_pid) || continue
			[ -n "$pid" ] || { fails=0; continue; }
			judged "$pid" || { fails=0; continue; }
			asked=$(date +%s)
			probe
			result=$?
			# the wait or the query took far longer than it should: the processes of the
			# router are starved, the backend among them
			round_late=""
			[ $((asked - began)) -le $((PROBE_INTERVAL + 5)) ] && [ $(($(date +%s) - asked)) -le $((PROBE_TIMEOUT + 3)) ] || round_late=1
			case $result in
			0)
				fails=0
				standing=0
				# the backend has just answered, so the router delivers: is the control answered
				if [ "$control" != 1 ] && [ "$tries" -lt 5 ]; then
					tries=$((tries + 1))
					if ping -c 1 -W "$PROBE_TIMEOUT" "$PROBE_SERVER" >/dev/null 2>&1; then
						control=1
					elif [ "$tries" -eq 5 ]; then
						log "the router does not answer a ping of $PROBE_SERVER: the liveness probe goes on without that control"
					fi
				fi
				;;
			1)
				if [ -n "$round_late" ] || router_silent; then
					fails=0
					standing=$((standing + 1))
					[ "$standing" -eq 3 ] && log "the liveness probe waits: the router itself is slow or does not deliver (its connection table is full, a ping of $PROBE_SERVER is not answered within $PROBE_TIMEOUT s, or the probe ran late)"
					continue
				fi
				standing=0
				[ "$fails" -eq 0 ] && since=$asked
				fails=$((fails + 1))
				[ "$fails" -ge "$PROBE_FAILURES" ] || continue
				# not a process that took the number of one that has just exited
				current=$(backend_pid) || continue
				silent=$(($(date +%s) - since))
				fails=0
				[ "$current" = "$pid" ] && judged "$pid" || continue
				kill -0 "$main" 2>/dev/null || break
				echo "$pid $(date +%s) $silent" > "$MARK"
				log "the backend (pid $pid, $bstate) has not answered DNS on $PROBE_SERVER for $silent s; killing it so that procd starts it again"
				kill -KILL "$pid" 2>/dev/null
				;;
			esac
		done
	) &
fi

# a start that failed: the backend that failed asked to try again every RETRY seconds from
# RETRY seconds after the failure (the state says when it failed last); told once a failure
(
	asked=0
	told=""
	while kill -0 "$main" 2>/dev/null; do
		waited=0
		while [ "$waited" -lt 30 ] && kill -0 "$main" 2>/dev/null; do
			sleep 5
			waited=$((waited + 5))
		done
		fstate="" fpid="" fsince=""
		{ read -r fstate fpid fsince < "$STATE"; } 2>/dev/null
		[ "$fstate" = failed ] || continue
		now=$(date +%s)
		[ $((now - ${fsince:-0})) -ge "$RETRY" ] && [ $((now - asked)) -ge "$RETRY" ] || continue
		# not a backend that has gone (procd gave up on it) and left its state behind
		pid=$(backend_pid) && [ -n "$pid" ] && [ "$pid" = "$fpid" ] || continue
		asked=$now
		if [ "$told" != "$fsince" ]; then
			told=$fsince
			log "the backend (pid $fpid) has given the router back since its start failed $((now - fsince)) s ago: it is asked to try again"
		fi
		/usr/bin/podkop restore_routing > /dev/null 2>&1
	done
) &

# seconds without an answer after which the probe has just killed the backend, if it has
liveness_kill() {
	[ -f "$MARK" ] || return 1
	read -r _ killed silent < "$MARK"
	rm -f "$MARK"
	[ $(($(date +%s) - ${killed:-0})) -le 60 ] || return 1
	echo "${silent:-?}"
}

# memory when the backend went down, so that a report from a router shows whether memory
# ran out there or the backend grew
memory_state() {
	awk '/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2} END {printf "MemTotal %d MB, MemAvailable %d MB", t / 1024, a / 1024}' /proc/meminfo
	rss=$(dmesg 2>/dev/null | grep 'Killed process .*(podkop)' | tail -n 1 | sed -n 's/.*anon-rss:\([0-9]*\)kB.*/\1/p')
	[ -n "$oom_last" ] && [ -n "$rss" ] && printf "; the backend had %d MB when killed" $((rss / 1024))
	df -k /tmp 2>/dev/null | awk 'NR == 2 {printf "; /tmp %d of %d MB", $3 / 1024, $2 / 1024}'
	cache=$(uci -q get podkop.settings.cache_path || echo /usr/share/podkop/cache.db)
	[ -f "$cache" ] && wc -c < "$cache" | awk -v c="$cache" '{printf "; %s %.1f MB", c, $1 / 1048576}'
	for status in /proc/[0-9]*/status; do
		awk '/^Name:/ {n = $2} /^VmRSS:/ {print $2, n}' "$status" 2>/dev/null
	done | sort -rn | head -n 3 | awk '{printf "%s%s %d MB", NR == 1 ? "; largest: " : ", ", $2, $1 / 1024}'
}

# was the last crash an OOM kill of the backend: the kernel counted a new OOM kill and its
# latest victim is podkop (the name of the binary)
oom_seen=$(oom_kills)
oom_new() {
	n=$(oom_kills)
	[ "${n:-0}" -gt "${oom_seen:-0}" ] && dmesg 2>/dev/null | grep 'Killed process' | tail -n 1 | grep -q '(podkop)'
	r=$?; oom_seen=$n; return $r
}

# The stop of podkop gives the router back what the backend took. A binary that cannot
# run (cut short by an upgrade that ran out of space, say) cannot do that: dnsmasq is then
# pointed back at the router's servers here, as the backend does it, and the firewall
# table goes. The rules of the marks left behind (priorities 104 and 105) do nothing
# without the marks of the table.
raw_release() {
	S='dhcp.@dnsmasq[0]'
	case " $(uci -q get $S.server) " in
	*' 127.0.0.42 '*) ;;
	*) return 1 ;;
	esac
	kept_servers=$(uci -q get $S.podkop_server)
	kept_noresolv=$(uci -q get $S.podkop_noresolv)
	kept_cachesize=$(uci -q get $S.podkop_cachesize)
	uci -q delete $S.server
	if [ -n "$kept_servers" ]; then
		for server in $kept_servers; do uci add_list $S.server="$server"; done
		uci -q delete $S.podkop_server
	elif [ -f /tmp/resolv.conf.d/resolv.conf.auto ]; then
		uci set $S.resolvfile=/tmp/resolv.conf.d/resolv.conf.auto
		# no servers to ask and told not to read the resolvers: it would ask nobody
		kept_noresolv=0
	fi
	uci set $S.noresolv="${kept_noresolv:-0}"
	uci -q delete $S.podkop_noresolv
	uci set $S.cachesize="${kept_cachesize:-150}"
	uci -q delete $S.podkop_cachesize
	# given back: a later release must not take the servers put back here for its own
	uci -q delete $S.podkop_taken
	uci commit dhcp
	# a restart, not the backend's reload: nothing looks after dnsmasq once the backend is
	# gone, and only a restart replaces a process left running with an older file
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	nft delete table inet PodkopTable 2>/dev/null
	return 0
}

loop_oom=""    # an OOM kill happened in the current crash loop
loop_mute=""   # the liveness probe killed the backend in the current crash loop
last_crash=0
while read -r event; do
	case "$event" in
	*'"instance.respawn"'*'"service":"podkop"'*)
		now=$(date +%s)
		[ $((now - last_crash)) -gt 600 ] && loop_oom="" && loop_mute=""   # a new crash loop
		last_crash=$now
		why=""; oom_last=""
		if silent=$(liveness_kill); then
			why=" (killed by the liveness probe: no DNS answer for $silent s)"
			loop_mute=1
			oom_new   # keep the count of OOM kills current
		elif oom_new; then
			why=" (killed by the kernel OOM-killer)"
			loop_oom=1; oom_last=1
		fi
		log "the backend exited unexpectedly$why, procd starts it again; $(memory_state)"
		;;
	*'"instance.start"'*'"service":"podkop"'*)
		# A kill that procd did not report as a crash (it was stopping or restarting that
		# instance itself) must not explain an exit of the process started now.
		rm -f "$MARK"
		;;
	*'"instance.fail"'*'"service":"podkop"'*)
		oom_last=""
		# the last crash is reported as instance.fail, not respawn
		if liveness_kill >/dev/null; then
			loop_mute=1
			oom_new
		elif oom_new; then
			loop_oom=1; oom_last=1
		fi
		err=$(last_error)
		state="the backend went down for good; $(memory_state)"
		log "$state"
		[ -n "$loop_mute" ] && err="killed by the liveness probe (it ran and did not answer DNS)${err:+; $err}"
		[ -n "$loop_oom" ] && err="killed by the kernel OOM-killer${err:+; $err}"
		loop_oom=""; loop_mute=""; last_crash=0
		cause="the backend keeps crashing and procd stopped starting it; stopping podkop so that DNS works without it${err:+. Last error: $err}"
		log "$cause"
		/etc/init.d/podkop stop >/dev/null 2>&1
		raw_release && log "the backend could not give the router back its DNS: dnsmasq asks the router's servers again and the firewall table is removed"
		# after DNS is back, and never in its way: the overlay may be full or read-only
		mkdir -p "${LAST%/*}" 2>/dev/null
		{ date '+%Y-%m-%d %H:%M:%S %z'; echo "$state"; echo "$cause"; } > "$LAST" 2>/dev/null || true
		;;
	esac
done < "$FIFO"
