{
  "luci-app-podkop": {
    "description": "Grant UCI and RPC access to LuCI app podkop",
    "read": {
      "file": {
        "/etc/init.d/podkop": [
          "exec"
        ],
        "/usr/bin/podkop": [
          "exec"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ],
        "log": [
          "read"
        ],
        "podkop": [
          "run",
          "stats",
          "detect"
        ]
      },
      "uci": [
        "podkop",
        "network",
        "firewall"
      ]
    },
    "write": {
      "ubus": {
        "podkop": [
          "force_detect"
        ]
      },
      "uci": [
        "podkop"
      ]
    }
  }
}
