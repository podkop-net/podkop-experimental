config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'
	list routing_excluded_ips '192.168.1.10'

config section 'ads'
	option user_domain_list_type 'dynamic'
	list user_domains 'ads.example'
	list user_domains 'tracker.example'
	list fully_routed_ips '192.168.1.66'

config member
	option section 'ads'
	option role 'server'
	option source 'block'

config section 'bank'
	option user_domain_list_type 'dynamic'
	list user_domains 'bank.example'
	list community_lists 'russia_inside'

config member
	option section 'bank'
	option role 'server'
	option source 'direct'

config source 'own'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.10:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=0123abcd&flow=xtls-rprx-vision&type=tcp&encryption=none&fp=chrome#NL%20Reality'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'
	list fully_routed_ips '192.168.1.50'

config member
	option section 'main'
	option role 'server'
	option source 'own'

config section 'late'
	option user_domain_list_type 'dynamic'
	list user_domains 'late-direct.example'

config member
	option section 'late'
	option role 'server'
	option source 'direct'

config member
	option section 'late'
	option role 'server'
	option source 'direct'

config source 'videosrc'
	option type 'links'
	list link 'vless://1d8af00a-326d-47d5-ad31-4bcc2767a48d@ws.example.org:443?security=tls&type=ws&host=cdn.example.org&path=%2Fws&sni=ws.example.org&fp=firefox#DE%20WS'

config section 'video'
	list community_lists 'youtube'
	list fully_routed_ips '192.168.1.60'

config member
	option section 'video'
	option role 'server'
	option source 'videosrc'

config section 'lateblock'
	option user_subnet_list_type 'dynamic'
	list user_subnets '198.51.100.0/24'

config member
	option section 'lateblock'
	option role 'server'
	option source 'block'
