config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'hy2'
	option type 'links'
	list link 'hysteria2://golden-hy2@hy.example.org:443/?sni=hy.example.org&obfs=salamander&obfs-password=golden-obfs#HY2'

config source 'tuic'
	option type 'links'
	list link 'tuic://52bda3d4-630e-481a-8e23-d3e8ec070abc:golden-tuic@tuic.example.org:443?congestion_control=bbr&alpn=h3&sni=tuic.example.org#TUIC'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config member
	option section 'main'
	option role 'server'
	option source 'hy2'

config member
	option section 'main'
	option role 'server'
	option source 'tuic'
