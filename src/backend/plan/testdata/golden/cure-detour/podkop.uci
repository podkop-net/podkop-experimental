config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'own'
	option type 'json'
	option outbound_json '{"type": "vless", "server": "203.0.113.85", "server_port": 443, "uuid": "a4aed896-0146-4777-a6ba-5434b88f7aba", "tls": {"enabled": true, "server_name": "d.example.org"}}'

config source 'relay'
	option type 'json'
	option outbound_json '{"type": "vless", "server": "203.0.113.84", "server_port": 443, "uuid": "52bda3d4-630e-481a-8e23-d3e8ec070abc", "tls": {"enabled": true, "server_name": "relay.example.org"}}'

config source 'pool'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.91:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=01&type=tcp&fp=chrome#P1'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.92:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=01&type=tcp&fp=chrome#P2'

config source 'other'
	option type 'json'
	option outbound_json '{"type": "vless", "server": "203.0.113.82", "server_port": 443, "uuid": "1d8af00a-326d-47d5-ad31-4bcc2767a48d", "tls": {"enabled": true, "server_name": "b.example.org"}}'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config member
	option section 'main'
	option role 'server'
	option source 'own'

config member
	option section 'main'
	option role 'server'
	option source 'other'

config cure
	option hash '06f04a30f00d7c5e50e934a7'
	option kind 'detour'
	option through 'relay'
	option relay 'b18f3b63e6da3071a2049bc9'

config cure
	option hash '340431d63284711c5b13718b'
	option kind 'detour'
	option through 'pool'

config cure
