config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'
	option bittorrent 'section'
	option bittorrent_section 'torrents'
	option bittorrent_section_scope 'lan'
	option bittorrent_confirmed 'learn'
	list bittorrent_router_users 'transmission'
	list bittorrent_router_users 'aria2'
	list bittorrent_router_users 'root'
	list bittorrent_router_users 'ghost'
	list bittorrent_router_users 'aria2'

config source 'own'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.10:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=0123abcd&flow=xtls-rprx-vision&type=tcp&encryption=none&fp=chrome#NL%20Reality'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config member
	option section 'main'
	option role 'server'
	option source 'own'

config source 'cheap'
	option type 'links'
	list link 'vless://1d8af00a-326d-47d5-ad31-4bcc2767a48d@ws.example.org:443?security=tls&type=ws&host=cdn.example.org&path=%2Fws&sni=ws.example.org&fp=firefox#DE%20WS'

config section 'torrents'

config member
	option section 'torrents'
	option role 'server'
	option source 'cheap'
