config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'vmess'
	option type 'links'
	list link 'vmess:'

config source 'anytls'
	option type 'links'
	list link 'anytls://golden-anytls@any.example.org:443/?sni=any.example.org#AnyTLS'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config member
	option section 'main'
	option role 'server'
	option source 'vmess'

config member
	option section 'main'
	option role 'server'
	option source 'anytls'
