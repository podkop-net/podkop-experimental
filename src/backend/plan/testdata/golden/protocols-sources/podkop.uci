config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'mine'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.41:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=01&type=tcp&fp=chrome#NL%201'
	list link 'hysteria2://golden-hy2@hy.example.org:443/?sni=hy.example.org#NL%202'
	list link 'trojan://golden-trojan@tr.example.org:443?sni=tr.example.org&type=ws&path=%2Ftr#NL%203'

config source 'one'
	option type 'links'
	list link 'ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpnb2xkZW4tcGFzcw@198.51.100.20:8388#One'

config source 'object'
	option type 'json'
	option label 'Proxy JSON'
	option outbound_json '{"type": "http", "server": "198.51.100.61", "server_port": 8080}'

config source 'wan2'
	option type 'interface'
	option label 'Second WAN'
	option interface 'wan2'

config section 'mixed'
	option user_domain_list_type 'dynamic'
	list user_domains 'mixed.example'

config member
	option section 'mixed'
	option role 'server'
	option source 'mine'
	list protocols 'vless'
	list protocols 'trojan'

config section 'single'
	option user_domain_list_type 'dynamic'
	list user_domains 'single.example'

config member
	option section 'single'
	option role 'server'
	option source 'one'
	list protocols 'shadowsocks'

config section 'json'
	option user_domain_list_type 'dynamic'
	list user_domains 'json.example'

config member
	option section 'json'
	option role 'server'
	option source 'object'
	list protocols 'http'

config section 'others'
	option user_domain_list_type 'dynamic'
	list user_domains 'others.example'

config member
	option section 'others'
	option role 'server'
	option source 'one'
	list protocols 'vless'

config member
	option section 'others'
	option role 'server'
	option source 'object'
	list protocols 'vless'

config member
	option section 'others'
	option role 'server'
	option source 'mine'
	list protocols 'hysteria2'

config section 'device'
	option user_domain_list_type 'dynamic'
	list user_domains 'device.example'

config member
	option section 'device'
	option role 'server'
	option source 'wan2'
	list protocols 'vless'
