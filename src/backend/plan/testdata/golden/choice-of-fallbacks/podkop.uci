config member
	option section 'twice'
	option role 'server'
	option source 'pair'

config member
	option section 'twice'
	option role 'fallback'
	option source 'pair'

config member
	option section 'twice'
	option role 'fallback'
	option source 'reserve'

config member
	option section 'twice'
	option role 'fallback'
	option source 'reserve'
	list include 'R1'

