config section 'balance'
	option user_domain_list_type 'dynamic'
	list user_domains 'balance.example'
	option server_choice 'loss'
	option fallback_choice 'balance'
	option loss_check_interval '10'
	option loss_threshold '2.5'

config member
	option section 'balance'
	option role 'server'
	option source 'pair'

config member
	option section 'balance'
