config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'
	option ipv6_routing 'both'
	option dns_addresses 'v6'
	option bittorrent 'section'
	option bittorrent_section 'nothere'

config source 'own'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.10:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=0123abcd&flow=xtls-rprx-vision&type=tcp&encryption=none&fp=chrome#NL%20Reality'

config source 'empty'

config source 'odd'
	option type 'wireguard'
	option link 'wg://x'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'
	option mixed_proxy_enabled '1'
	option mixed_proxy_port '2080'

config member
	option section 'main'
	option role 'server'
	option source 'own'

config member
	option section 'main'
	option role 'server'
	option source 'direct'

config member
	option section 'main'
	option role 'server'
	option source 'nosuch'

config section 'unfilled'
	option user_domain_list_type 'dynamic'
	list user_domains 'unfilled.example'

config member
	option section 'unfilled'
	option role 'server'
	option source 'empty'

config member
	option section 'unfilled'
	option role 'server'
	option source 'odd'

config section 'nolists'

config member
	option section 'nolists'
	option role 'server'
	option source 'own'

config section 'tvonly'
	option user_domain_list_type 'dynamic'
	list user_domains 'tv.example'
	list only_devices 'tv'
	list only_devices 'phone'

config member
	option section 'tvonly'
	option role 'server'
	option source 'own'
