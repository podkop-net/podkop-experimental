  "route": {
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "tproxy-in",
          "dns-in"
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route-options",
        "domain_suffix": "fakeipchecker.podkop.net",
        "override_address": "127.0.0.1",
        "override_port": 1603
      },
      {
        "action": "route",
        "ip_cidr": "127.0.0.1",
        "port": 1603,
        "outbound": "direct-out"
      },
      {
        "action": "route",
        "inbound": "tproxy-in",
        "outbound": "main-out",
        "rule_set": "main-user-domains-ruleset"
      },
      {
        "action": "route",
        "inbound": "tproxy-in",
        "outbound": "onlyfallback-out",
        "rule_set": "onlyfallback-user-domains-ruleset"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "main-user-domains-ruleset",
        "format": "source",
        "path": "/var/run/podkop/rulesets/main-user-domains-ruleset.json"
      },
      {
        "type": "local",
        "tag": "onlyfallback-user-domains-ruleset",
        "format": "source",
        "path": "/var/run/podkop/rulesets/onlyfallback-user-domains-ruleset.json"
      }
    ],
    "final": "direct-out",
    "default_mark": 2097152,
    "default_domain_resolver": "dns-server",
    "default_http_client": "lists"
  },
  "services": [],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/usr/share/podkop/cache.db",
      "store_fakeip": true
