        "type": "fakeip",
        "tag": "fakeip-server",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "action": "reject",
        "query_type": "HTTPS"
      },
      {
        "action": "reject",
        "domain_suffix": "use-application-dns.net"
      },
      {
        "action": "route",
        "server": "dns-server",
        "domain": [
          "0.openwrt.pool.ntp.org",
          "1.openwrt.pool.ntp.org",
          "2.openwrt.pool.ntp.org",
          "3.openwrt.pool.ntp.org"
        ]
      },
      {
        "action": "route",
        "server": "fakeip-server",
        "rewrite_ttl": 60,
        "rule_set": [
          "main-user-domains-ruleset",
          "onlyfallback-user-domains-ruleset"
        ]
      },
      {
        "action": "route",
        "server": "fakeip-server",
        "rewrite_ttl": 60,
