config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'
	option urltest_loss_url 'ftp://loss.example.org/1mb'

config source 'a'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.10:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=0123abcd&flow=xtls-rprx-vision&type=tcp&encryption=none&fp=chrome#NL%20Reality'

config source 'b'
	option type 'links'
	list link 'vless://1d8af00a-326d-47d5-ad31-4bcc2767a48d@ws.example.org:443?security=tls&type=ws&host=cdn.example.org&path=%2Fws&sni=ws.example.org&fp=firefox#DE%20WS'

config source 'c'
	option type 'links'
	list link 'vless://52bda3d4-630e-481a-8e23-d3e8ec070abc@grpc.example.org:443?security=tls&type=grpc&serviceName=svc&sni=grpc.example.org#FI%20gRPC'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'
	option server_choice 'balance'
	option loss_threshold '5'

config member
	option section 'main'
	option role 'server'
	option source 'a'

config member
	option section 'main'
	option role 'server'
	option source 'b'

config member
	option section 'main'
	option role 'server'
	option source 'c'

config section 'odd'
	option user_domain_list_type 'dynamic'
	list user_domains 'odd.example'
	option server_choice 'balance'
	option loss_threshold '80'
	option loss_check_interval '2'

config member
	option section 'odd'
	option role 'server'
	option source 'a'

config member
	option section 'odd'
	option role 'server'
	option source 'b'

config section 'unknown'
	option user_domain_list_type 'dynamic'
	list user_domains 'unknown.example'
	option server_choice 'random'

config member
	option section 'unknown'
	option role 'server'
	option source 'b'

config member
	option section 'unknown'
	option role 'server'
	option source 'c'
