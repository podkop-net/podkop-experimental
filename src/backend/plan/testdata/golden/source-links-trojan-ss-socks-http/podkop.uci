config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'trojan'
	option type 'links'
	list link 'trojan://golden-trojan@tr.example.org:443?sni=tr.example.org&type=ws&path=%2Ftr#Trojan%20WS'

config source 'ss'
	option type 'links'
	list link 'ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpnb2xkZW4tcGFzcw@198.51.100.20:8388#SS%20classic'
	option udp_over_tcp '1'

config source 'ss2022'
	option type 'links'
	list link 'ss://2022-blake3-aes-256-gcm:FbzszGzHO2duw%2BV6PkQ1Rvy6f0Mw78%2BBjNAWMPzBtMM%3D@198.51.100.21:8443#SS%202022'

config source 'socks'
	option type 'links'
	list link 'socks5://golden:golden-pass@203.0.113.30:1080#SOCKS'
	option udp_over_tcp '1'

config source 'http'
	option type 'links'
	list link 'http://golden:golden-pass@203.0.113.31:3128#HTTP'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config member
	option section 'main'
	option role 'server'
	option source 'trojan'

config member
	option section 'main'
	option role 'server'
	option source 'ss'

config member
	option section 'main'
	option role 'server'
	option source 'ss2022'

config member
	option section 'main'
	option role 'server'
	option source 'socks'

config member
	option section 'main'
	option role 'server'
	option source 'http'
