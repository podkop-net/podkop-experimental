config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '6h'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'own'
	option type 'links'
	list link 'vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.10:443?security=reality&sni=www.example.com&pbk=6x33-mZSKbpyS22-wakXnzZvlay3BUianS6cPaJQ-Ow&sid=0123abcd&flow=xtls-rprx-vision&type=tcp&encryption=none&fp=chrome#NL%20Reality'

config section 'main'
	list remote_domain_lists 'https://lists.example.org/a.srs'
	list remote_domain_lists 'https://lists.example.org/b.json'
	list remote_domain_lists 'https://lists.example.org/c.lst'
	list remote_domain_lists 'https://lists.example.org/d.txt?token=1'
	list remote_domain_lists 'https://mirror.example.org/a.srs'
	list remote_subnet_lists 'https://lists.example.org/nets.srs'
	list remote_subnet_lists 'https://lists.example.org/nets.lst'

config member
	option section 'main'
	option role 'server'
	option source 'own'
