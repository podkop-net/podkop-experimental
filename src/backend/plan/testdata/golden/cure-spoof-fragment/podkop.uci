config settings 'settings'
	option config_version '2'
	option dns_type 'udp'
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option update_interval '1d'
	option cache_path '/usr/share/podkop/cache.db'
	option log_level 'warn'

config source 'a'
	option type 'json'
	option outbound_json '{"type": "vless", "server": "203.0.113.81", "server_port": 443, "uuid": "9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4", "tls": {"enabled": true, "server_name": "a.example.org", "utls": {"enabled": true, "fingerprint": "chrome"}}}'

config source 'b'
	option type 'json'
	option outbound_json '{"type": "vless", "server": "203.0.113.82", "server_port": 443, "uuid": "1d8af00a-326d-47d5-ad31-4bcc2767a48d", "tls": {"enabled": true, "server_name": "b.example.org"}}'

config source 'c'
	option type 'json'
	option outbound_json '{"type": "socks", "server": "203.0.113.83", "server_port": 1080}'

config source 'e'
	option type 'json'
	option outbound_json '{"type": "trojan", "server": "203.0.113.86", "server_port": 443, "password": "golden", "tls": {"enabled": true, "server_name": "e.example.org"}}'

config source 'relay'
	option type 'json'
	option outbound_json '{"type": "vless", "server": "203.0.113.84", "server_port": 443, "uuid": "52bda3d4-630e-481a-8e23-d3e8ec070abc", "tls": {"enabled": true, "server_name": "relay.example.org"}}'

config section 'main'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config member
	option section 'main'
	option role 'server'
	option source 'a'

config member
	option section 'main'
	option role 'server'
	option source 'b'

config member
	option section 'main'
	option role 'server'
	option source 'c'

config member
	option section 'main'
	option role 'server'
	option source 'e'

config section 'far'
	option user_domain_list_type 'dynamic'
	list user_domains 'far.example'

config member
	option section 'far'
	option role 'server'
	option source 'b'
	option via 'relay'

